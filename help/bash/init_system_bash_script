#!/usr/bin/env bash

# Sets the script to exit immediately when any error, unset variable, or pipeline failure occurs
set -euo pipefail

# IF ELSE

# Text formatting
red=$(tput setaf 1)
green=$(tput setaf 2)
reset=$(tput sgr0)

# Detect init
if ps -p 1 -o comm= | grep -q "systemd"; then
    init_system="systemd"
    
elif ps -p 1 -o comm= | grep -q "runit"; then
    init_system="runit"
    
elif ps -p 1 -o comm= | grep -q "sysvinit"; then
    init_system="sysvinit"
    
elif ps -p 1 -o comm= | grep -q "openrc-init"; then
    init_system="openrc-init"
    
else
    init_system="unknown"
fi

# Checks for init system
if ps -p 1 -o comm= | grep -q "systemd"; then
    echo "${green}Detected Init System: $init_system ${reset}"
    
elif ps -p 1 -o comm= | grep -q "runit"; then
    echo "${green}Detected Init System: $init_system ${reset}"
    
elif ps -p 1 -o comm= | grep -q "sysvinit"; then
    echo "${green}Detected Init System: $init_system ${reset}"
    
elif ps -p 1 -o comm= | grep -q "openrc-init"; then
    echo "${green}Detected Init System: $init_system ${reset}"
    
else
    echo "${red}Unsupported init system ${reset}"
    exit 1
fi

# CASE

# Text formatting
red=$(tput setaf 1)
green=$(tput setaf 2)
reset=$(tput sgr0)

# Get init system
init_system=$(ps -p 1 -o comm=)

# Executes commands based on the init system
case "$init_system" in
    "systemd")
        echo "${green}Detected Init System: $init_info ${reset}"
        ;;
    "runit")
        echo "${green}Detected Init System: $init_info ${reset}"
        ;;
    "sysvinit")
        echo "${green}Detected Init System: $init_info ${reset}"
        ;;
    "openrc-init")
        echo "${green}Detected Init System: $init_info ${reset}"
        ;;
    *)
        echo "${red}Unsupported init system: $init_info ${reset}"
        exit 1
        ;;
esac
