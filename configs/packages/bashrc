                                    elif toolbox run yay -Qs "$package" > /dev/null 2>&1; then
                                        package_found=true
                                        echo "${red}Removing $package using $manager with $toolbox_manager... ${reset}"
                                        toolbox run yay -Rs "$package"

                                    elif toolbox run pacman -Qs "$package" > /dev/null 2>&1; then
                                        package_found=true
                                        echo "${red}Removing $package using $manager with $toolbox_manager... ${reset}"
                                        toolbox run sudo pacman -Rs "$package"
                                    fi
                                    ;;
                                "xbps")
                                    if toolbox run xbps-query -s "$package" > /dev/null 2>&1; then
                                        package_found=true
                                        echo "${red}Removing $package using $manager with $toolbox_manager... ${reset}"
                                        toolbox run sudo xbps-remove -R "$package"
                                    fi
                                    ;;
                                "zypper")
                                    if toolbox run zypper se -i --match-exact "$package" > /dev/null 2>&1; then
                                        package_found=true
                                        echo "${red}Removing $package using $manager with $toolbox_manager... ${reset}"
                                        toolbox run sudo zypper rm --clean-deps "$package"
                                    fi
                                    ;;
                            esac
                        done

                        if ! $package_found; then
                            echo "${yellow}$manager: '$package' not found ${reset}" >&2
                        fi
                    fi
                    ;;
                "rpm-ostree")
                    if command -v rpm-ostree > /dev/null 2>&1; then
                        if rpm-ostree list --installed "$package" > /dev/null 2>&1; then
                            echo "${red}Removing $package using $manager... ${reset}"
                            sudo rpm-ostree remove "$package"
                            
                        else
                            echo "${yellow}$manager: '$package' not found ${reset}" >&2
                        fi
                    fi
                    ;;
            esac
        done
    done
}

