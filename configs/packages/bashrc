                    echo "$upgrading"
                    upgrade_waydroid
                fi
                ;;
            "cinnamon-spice-updater")
                if command -v cinnamon-spice-updater > /dev/null 2>&1; then
                    echo "$updating"
                    upgrade_cinnamon_spices
                fi
                ;;
            "fwupdmgr")
                if command -v fwupdmgr > /dev/null 2>&1; then
                    echo "$updating"
                    upgrade_fwupdmgr
                fi
                ;;
            "rpm-ostree")
                if [ "$primary_package_manager" = "rpm-ostree" ]; then
                    echo "$upgrading"
                    upgrade_rpm_ostree
                fi
                ;;
        esac
    done
}
