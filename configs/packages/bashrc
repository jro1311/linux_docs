# Custom Settings

## BTRFS

alias balance='sudo btrfs balance start'
alias balance-status='sudo btrfs balance status'
alias balance-cancel='sudo btrfs balance cancel'
alias balance-pause='sudo btrfs balance pause'
alias balance-resume='sudo btrfs balance resume'
alias defrag='sudo btrfs fi defragment -rv'
alias diskusage='sudo btrfs fi usa'
alias ratio='sudo compsize -x'
alias scrub='sudo btrfs scrub start'
alias scrub-status='sudo btrfs scrub status'
alias scrub-cancel='sudo btrfs scrub cancel'
alias scrub-resume='sudo btrfs scrub resume'

## Environment Variables

export LINUX_DOCS="$HOME/Documents/linux_docs"
export LINUX_DOCS_CFG="$HOME/Documents/linux_docs/configs"
export LINUX_DOCS_DOC="$HOME/Documents/linux_docs/documentation"
export LINUX_DOCS_HELP="$HOME/Documents/linux_docs/help"
export LINUX_DOCS_SCR="$HOME/Documents/linux_docs/scripts"
export LINUX_DOCS_SS="$HOME/Documents/linux_docs/screenshots"
export LINUX_BACKUP1="/run/media/linux_backup1"
export LINUX_BACKUP2="/run/media/linux_backup2"
export PATH="$PATH:/usr/sbin:/snap/bin"
#export MANGOHUD=1

## Launchers

alias protontricks='flatpak run com.github.Matoking.protontricks'
alias protontricks-launch='flatpak run --command=protontricks-launch com.github.Matoking.protontricks'

## System Information

alias desktop='echo $XDG_CURRENT_DESKTOP'
alias diskinfo='sudo smartctl -a'
alias display='echo $XDG_SESSION_TYPE'
alias mountcheck='sudo findmnt --verify --verbose'
alias uuid='lsblk -o name,uuid'

# Detects the operating system and stores it in a variable

if [ -f /etc/os-release ]; then
    . /etc/os-release
    os="${ID:-unknown}"
    os_like="${ID_LIKE:-$os}"
fi

# Converts the variable into lowercase

os=$(echo "${os:-unknown}" | tr '[:upper:]' '[:lower:]')
os_like=$(echo "$os_like" | tr '[:upper:]' '[:lower:]')

# Functions

check() {
    if command -v apt &> /dev/null; then
        echo "Detected: apt"
        "Nothing to do"
    elif command -v dnf &> /dev/null; then
        echo "Detected: dnf"
        dnf check
    elif command -v pacman &> /dev/null; then
        echo "Detected: pacman"
        pacman -Qkk
    elif command -v rpm-ostree &> /dev/null; then
        echo "Detected: rpm-ostree"
        rpm-ostree check
    elif command -v xbps-query &> /dev/null; then
        echo "Detected: xbps"
        xbps-query -O
    elif command -v zypper &> /dev/null; then
        echo "Detected: zypper"
        zypper ps -s
    fi
}

clean() {
    if command -v apt &> /dev/null; then
        echo "Detected: apt"
        if command -v nala &> /dev/null; then
            sudo nala clean && sudo nala autoremove
        else
            sudo apt clean && sudo apt autoremove
        fi
    elif command -v dnf &> /dev/null; then
        echo "Detected: dnf"
        sudo dnf autoremove
    elif command -v pacman &> /dev/null; then
        echo "Detected: pacman"
        sudo pacman -Rns "$(pacman -Qdtq)" && sudo pacman -Sc
        if command -v paru &> /dev/null; then
            paru -Rns "$(paru -Qdtq)" && paru -Sc
        elif command -v yay &> /dev/null; then
            yay -Rns "$(yay -Qdtq)" && yay -Sc
        fi
    elif command -v rpm-ostree &> /dev/null; then
        echo "Detected: rpm-ostree"
        sudo rpm-ostree cleanup
    elif command -v xbps-remove &> /dev/null; then
        echo "Detected: xbps"
        sudo xbps-remove "$(xbps-query -Oo)"
    elif command -v zypper &> /dev/null; then
        echo "Detected: zypper"
        sudo zypper clean
    fi
    
    if command -v flatpak &> /dev/null; then
        echo "Detected: flatpak"
        flatpak uninstall --unused
    fi
}

off() {
    if ps -p 1 -o comm= | grep -q "systemd"; then
        echo "Detected: systemd"
        systemctl poweroff
    else
        poweroff
    fi
}

reboot() {
    if ps -p 1 -o comm= | grep -q "systemd"; then
        echo "Detected: systemd"
        systemctl reboot
    else
        reboot
    fi
}

update-grub() {
    if command -v update-grub &> /dev/null; then
        update-grub
    elif command -v grub2-mkconfig &> /dev/null; then
        grub2-mkconfig
    else
        echo "GRUB not detected"
    fi
}

upgrade() {
    if command -v apt &> /dev/null; then
        echo "Detected: apt"
        if command -v nala &> /dev/null; then
            sudo nala upgrade
        else
            sudo apt update && sudo apt upgrade
        fi
    elif command -v dnf &> /dev/null; then
        echo "Detected: dnf"
        sudo dnf upgrade
    elif command -v pacman &> /dev/null; then
        echo "Detected: pacman"
        sudo pacman -Syu
        if command -v paru &> /dev/null; then
            echo "Detected: paru"
            paru -Syu
        elif command -v yay &> /dev/null; then
            echo "Detected: paru"
            yay -Syu
        fi
    elif command -v rpm-ostree &> /dev/null; then
        echo "Detected: rpm-ostree"
        sudo rpm-ostree cleanup
    elif command -v xbps-install &> /dev/null; then
        echo "Detected: xbps"
        sudo xbps-install -Su xbps && sudo xbps-install -u
    elif command -v zypper &> /dev/null; then
        echo "Detected: zypper"
        if [ "$os" = "opensuse-tumbleweed" ] || [ "$os" = "opensuse-slowroll" ]; then
            sudo zypper ref && sudo zypper dup
        elif [ "$os" = "opensuse-leap" ]; then
            sudo zypper ref && sudo zypper up
        fi
    fi
    
    if command -v flatpak &> /dev/null; then
        echo "Detected: flatpak"
        flatpak update
    fi

    if command -v snap &> /dev/null; then
        echo "Detected: snap"
        sudo snap refresh
    fi
}
