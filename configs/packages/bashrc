search() {
    local package="$1"
    if [[ -z "$package" ]]; then
        echo "Enter a package name"
        return 1
    fi

    if command -v apt > /dev/null 2>&1; then
        echo "Searching for system package..."
        if command -v nala > /dev/null 2>&1; then
            nala search "$package"
        else
            apt search "$package"
        fi
    elif command -v dnf > /dev/null 2>&1; then
        echo "Searching for system package..."
        dnf search "$package"
    elif command -v pacman > /dev/null 2>&1; then
        echo "Searching for system package..."
        pacman -Ss "$package"
        if command -v paru > /dev/null 2>&1; then
            paru -Ss "$package"
        elif command -v yay > /dev/null 2>&1; then
            yay -Ss "$package"
        fi
    elif command -v rpm-ostree > /dev/null 2>&1; then
        echo "Searching for system package..."
        rpm-ostree search "$package"
    elif command -v xbps-query > /dev/null 2>&1; then
        echo "Searching for system package..."
        xbps-query -Rs "$package"
    elif command -v zypper > /dev/null 2>&1; then
        echo "Searching for system package..."
        zypper se "$package"
    else
        echo "Unsupported package manager"
        return 1
    fi

    if command -v flatpak > /dev/null 2>&1; then
        echo "Searching for flatpak..."
        flatpak search "$package"
    fi

    if command -v snap > /dev/null 2>&1; then
        echo "Searching for snap..."
        snap find "$package"
    fi
}

update_grub() {
    if command -v update-grub > /dev/null 2>&1; then
        sudo update-grub
    elif command -v grub2-mkconfig > /dev/null 2>&1; then
        sudo grub2-mkconfig -o /boot/grub2/grub.cfg
    elif command -v grub-mkconfig > /dev/null 2>&1; then
        sudo grub-mkconfig -o /boot/grub/grub.cfg
    else
        echo "GRUB not detected"
        return 1
    fi
}

upgrade() {
    if command -v apt > /dev/null 2>&1; then
        if command -v nala > /dev/null 2>&1; then
            sudo nala upgrade
        else
            sudo apt update && sudo apt upgrade
        fi
    elif command -v dnf > /dev/null 2>&1; then
        sudo dnf upgrade
    elif command -v pacman > /dev/null 2>&1; then
        sudo pacman -Syu
        if command -v paru > /dev/null 2>&1; then
            paru -Syu
        elif command -v yay > /dev/null 2>&1; then
            yay -Syu
        fi
    elif command -v rpm-ostree > /dev/null 2>&1; then
        sudo rpm-ostree cleanup
    elif command -v xbps-install > /dev/null 2>&1; then
        sudo xbps-install -Su xbps && sudo xbps-install -u
    elif command -v zypper > /dev/null 2>&1; then
        if [ "$os" = "opensuse-tumbleweed" ] || [ "$os" = "opensuse-slowroll" ]; then
            sudo zypper ref && sudo zypper dup
        elif [ "$os" = "opensuse-leap" ]; then
            sudo zypper ref && sudo zypper up
        fi
    else
        echo "Unsupported package manager"
        return 1
    fi
    
    if command -v flatpak > /dev/null 2>&1; then
        flatpak update
    fi

    if command -v snap > /dev/null 2>&1; then
        sudo snap refresh
    fi
}
