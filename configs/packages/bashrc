## Define text colors
red=$(tput setaf 1)
green=$(tput setaf 2)
yellow=$(tput setaf 3)
blue=$(tput setaf 4)
reset=$(tput sgr0)

## Define the operating system and convert it to lowercase
if [ -f /etc/os-release ]; then
    . /etc/os-release

    os="${ID:-unknown}"
    os_like="${ID_LIKE:-$os}"

    os=$(echo "${os:-unknown}" | tr '[:upper:]' '[:lower:]')
    os_like=$(echo "$os_like" | tr '[:upper:]' '[:lower:]')
fi

## Define primary and secondary package managers
primary_package_manager="unknown"
secondary_package_manager="unknown"

primary_package_managers=(apt dnf eopkg pacman xbps-install zypper rpm-ostree)
secondary_package_managers=(nala paru yay)

for cmd in "${primary_package_managers[@]}"; do
    if command -v "$cmd" >/dev/null 2>&1; then
        primary_package_manager="$cmd"
        break
    fi
done

for cmd in "${secondary_package_managers[@]}"; do
    if command -v "$cmd" >/dev/null 2>&1; then
        secondary_package_manager="$cmd"
        break
    fi
done

if [ "$primary_package_manager" = "xbps-install" ]; then
    primary_package_manager="xbps"
fi

## Checks for Toolbox and defines toolbox package managers
toolbox_installed=0
primary_toolbox_manager="unknown"
secondary_toolbox_manager="unknown"

primary_toolbox_managers=(apt dnf eopkg pacman xbps-install zypper)
secondary_toolbox_managers=(nala paru yay)

if command -v toolbox >/dev/null 2>&1; then
    toolbox_installed=1
    for cmd in "${primary_toolbox_managers[@]}"; do
        if toolbox run bash -c "command -v $cmd >/dev/null 2>&1"; then
            primary_toolbox_manager="$cmd"
            break
        fi
    done

    for cmd in "${secondary_toolbox_managers[@]}"; do
        if toolbox run bash -c "command -v $cmd >/dev/null 2>&1"; then
            secondary_toolbox_manager="$cmd"
            break
        fi
    done
fi

## Check for Flatpak
flatpak_installed=0
if command -v flatpak > /dev/null 2>&1; then
    flatpak_installed=1
fi

## Check for Snap
snap_installed=0
if command -v snap > /dev/null 2>&1; then
    snap_installed=1
fi

## Functions
confirm() {
    while true; do
        read -r -p "Confirm? [Y/n]: " answer
        answer="${answer:-y}"

        case "$answer" in
            [Yy])
                "$@"
                break
                ;;
            [Nn])
                break
                ;;
            *)
                echo "Enter y or n."
                ;;
        esac
    done
}

no_package_found() {
    local manager="$1"
    local package="$2"
    echo "${yellow}${manager}: '$package' not found${reset}" >&2
}

clean_apt() { sudo apt autoremove && sudo apt clean; }
clean_nala() { sudo nala autoremove && sudo nala clean; }
clean_dnf() { sudo dnf autoremove; }
clean_eopkg() { sudo eopkg remove-orphans && sudo eopkg delete-cache && sudo eopkg clean; }
clean_pacman_native() {
    if pacman -Qdtq > /dev/null 2>&1; then
        sudo pacman -Rns "$(pacman -Qdtq)"
    else
        echo "No packages to remove."
    fi

    sudo pacman -Sc; }
clean_pacman_aur() {
    if $secondary_package_manager -Qdtq > /dev/null 2>&1; then
        $secondary_package_manager -Rns "$($secondary_package_manager -Qdtq)"
    else
        echo "No packages to remove."
    fi
    $secondary_package_manager -Sc; }
clean_xbps() { sudo xbps-remove -Oo; }
clean_zypper() { sudo zypper purge-kernels && zypper clean; }
clean_flatpak() { flatpak uninstall --unused; }
clean_rpm_ostree() { sudo rpm-ostree cleanup -bm; }
clean_toolbox() {
    local toolbox_managers=(apt dnf eopkg pacman xbps zypper)

    for toolbox_manager in "${toolbox_managers[@]}"; do
        local cleaning_toolbox="${red}Cleaning inside toolbox container using $toolbox_manager... ${reset}"

        case "$toolbox_manager" in
            apt)
                if [ "$secondary_toolbox_manager" = "nala" ]; then
                    echo "$cleaning_toolbox"
                    toolbox run bash -c 'sudo nala autoremove && sudo nala clean'

                elif [ "$primary_toolbox_manager" = "apt" ]; then
                    echo "$cleaning_toolbox"
                    toolbox run bash -c 'sudo apt autoremove && sudo apt clean'
                fi
                ;;
            dnf)
                if [ "$primary_toolbox_manager" = "dnf" ]; then
                    echo "$cleaning_toolbox"
                    toolbox run bash -c 'sudo dnf autoremove'
                fi
                ;;
            eopkg)
                if [ "$primary_toolbox_manager" = "eopkg" ]; then
                    echo "$cleaning_toolbox"
                    toolbox run bash -c 'sudo eopkg remove-orphans && sudo eopkg delete-cache && sudo eopkg clean'
                fi
                ;;
            pacman)
                if [[ "$secondary_toolbox_manager" =~ ^(paru|yay)$ ]]; then
                    echo "$cleaning_toolbox"
                    toolbox run bash -c "
                        orphans=\$($secondary_toolbox_manager -Qdtq)
                        [ -n "\$orphans" ] && \"$secondary_toolbox_manager\" -Rns "\$orphans" || echo 'No packages to remove.'
                        \"$secondary_toolbox_manager\" -Sc
                    "
                elif [ "$primary_package_manager" = "pacman" ]; then
                    echo "$cleaning_toolbox"
                    toolbox run bash -c "
                        orphans=\$(pacman -Qdtq)
                        [ -n "\$orphans" ] && sudo pacman -Rns "\$orphans" || echo 'No packages to remove.'
                        sudo pacman -Sc
                    "
                fi
                ;;
            xbps)
                if [ "$primary_toolbox_manager" = "xbps" ]; then
                    echo "$cleaning_toolbox"
                    toolbox run bash -c 'sudo xbps-remove -Oo'
                fi
                ;;
            zypper)
                if [ "$primary_toolbox_manager" = "zypper" ]; then
                    echo "$cleaning_toolbox"
                    toolbox run bash -c 'sudo zypper purge-kernels && sudo zypper clean'
                fi
                ;;
        esac
    done
}

clean() {
    local managers=(apt dnf eopkg pacman xbps zypper flatpak toolbox rpm-ostree)

    for manager in "${managers[@]}"; do
        local cleaning="${red}Cleaning system using $manager... ${reset}"

        case "$manager" in
            "apt")
                if [ "$secondary_package_manager" = "nala" ]; then
                    echo "$cleaning"
                    clean_nala

                elif [ "$primary_package_manager" = "apt" ]; then
                    echo "$cleaning"
                    clean_apt
                fi
                ;;
            "dnf")
                if [ "$primary_package_manager" = "dnf" ]; then
                    echo "$cleaning"
                    clean_dnf
                fi
                ;;
            "eopkg")
                if [ "$primary_package_manager" = "eopkg" ]; then
                    echo "$cleaning"
                    clean_eopkg
                fi
                ;;
            "pacman")
                if [[ "$secondary_package_manager" =~ ^(paru|yay)$ ]]; then
                    echo "$cleaning"
                    clean_pacman_aur

                elif [ "$primary_package_manager" = "pacman" ]; then
                    echo "$cleaning"
                    clean_pacman_native
                fi
                ;;
            "xbps")
                if [ "$primary_package_manager" = "xbps" ]; then
                    echo "$cleaning"
                    clean_xbps
                fi
                ;;
            "zypper")
                if [ "$primary_package_manager" = "zypper" ]; then
                    echo "$cleaning"
                    clean_zypper
                fi
                ;;
            "flatpak")
                if [ "$flatpak_installed" -eq 1 ]; then
                    echo "$cleaning"
                    clean_flatpak
                fi
                ;;
            "toolbox")
                if [ "$toolbox_installed" -eq 1 ]; then
                    echo "$cleaning"
                    clean_toolbox
                fi
                ;;
            "rpm-ostree")
                if [ "$primary_package_manager" = "rpm-ostree" ]; then
                    echo "$cleaning"
                    rpm_ostree_clean
                fi
                ;;
        esac
    done
}

install_apt() {
    local package="$1"
    local installing="$2"
    if apt list "$package" 2>/dev/null | grep -Fiq "$package"; then
        echo "$installing"
        sudo apt install "$package"
    else
        no_package_found "apt" "$package"
    fi
}

install_nala() {
    local package="$1"
    local installing="$2"
    if apt list "$package" 2>/dev/null | grep -Fiq "$package"; then
        echo "$installing"
        sudo nala install "$package"
    else
        no_package_found "nala" "$package"
    fi
}

install_dnf() {
    local package="$1"
    local installing="$2"
    if dnf list --available "$package" > /dev/null 2>&1; then
        echo "$installing"
        sudo dnf install "$package"
    else
        no_package_found "dnf" "$package"
    fi
}

install_eopkg() {
    local package="$1"
    local installing="$2"
    if eopkg search --name "^$package" | grep -Fiq "$package"; then
        echo "$installing"
        sudo eopkg install "$package"
    else
        no_package_found "eopkg" "$package"
    fi
}

install_pacman_native() {
    local package="$1"
    local installing="$2"
    if pacman -Ss "^$package" > /dev/null 2>&1; then
        echo "$installing"
        sudo pacman -S "$package"
    else
        no_package_found "pacman" "$package"
    fi
}

install_pacman_aur() {
    local package="$1"
    local installing="$2"
    if $secondary_package_manager -Ss "^$package" > /dev/null 2>&1; then
        echo "$installing"
        $secondary_package_manager -S "$package"
    else
        no_package_found "$secondary_package_manager" "$package"
    fi
}

install_xbps() {
    local package="$1"
    local installing="$2"
    if xbps-query -Rs "$package" | grep -Fiq "$package"; then
        echo "$installing"
        sudo xbps-install -S "$package"
    else
        no_package_found "xbps" "$package"
    fi
}

install_zypper() {
    local package="$1"
    local installing="$2"
    if zypper se --match-exact "$package" > /dev/null 2>&1; then
        echo "$installing"
        sudo zypper in "$package"
    else
        no_package_found "zypper" "$package"
    fi
}

install_flatpak() {
    local package="$1"
    local installing="$2"
    if flatpak search --columns=name,application "$package" | grep -Fiq "$package"; then
        echo "$installing"
        flatpak install "$package"
    else
        no_package_found "flatpak" "$package"
    fi
}

install_snap() {
    local package="$1"
    local installing="$2"
    if snap find "$package" | awk '{print $1}' | grep -iq "^$package"; then
        echo "$installing"
        confirm sudo snap install "$package"
    else
        no_package_found "snap" "$package"
    fi
}

install_rpm_ostree() {
    local package="$1"
    local installing="$2"
    if rpm-ostree search "$package" | awk 'NR > 2 {print $1}' | grep -iq "^$package"; then
        echo "$installing"
        confirm sudo rpm-ostree install "$package"
    else
        no_package_found "rpm-ostree" "$package"
    fi
}

install_toolbox() {
    local package="$1"
    local toolbox_managers=(apt dnf eopkg pacman xbps zypper)

    for toolbox_manager in "${toolbox_managers[@]}"; do
        local installing_toolbox="${green}Installing '$package' inside toolbox container using $toolbox_manager... ${reset}"
        local no_toolbox_package_found="${yellow}$toolbox_manager: '$package' not found ${reset}"

        case "$toolbox_manager" in
            apt)
                if [ "$secondary_toolbox_manager" = "nala" ]; then
                    echo "$installing_toolbox"
                    toolbox run bash -c "
                        if apt list \"$package\" 2>/dev/null | grep -Fiq \"$package\"; then
                            sudo nala install \"$package\"
                        else
                            echo \"$no_toolbox_package_found\" >&2
                        fi
                    "
                elif [ "$primary_toolbox_manager" = "apt" ]; then
                    echo "$installing_toolbox"
                    toolbox run bash -c "
                        if apt list \"$package\" 2>/dev/null | grep -Fiq \"$package\"; then
                            sudo apt install \"$package\"
                        else
                            echo \"$no_toolbox_package_found\" >&2
                        fi
                    "
                fi
                ;;
            dnf)
                if [ "$primary_toolbox_manager" = "dnf" ]; then
                    echo "$installing_toolbox"
                    toolbox run bash -c "
                        if dnf list --available \"$package\" > /dev/null 2>&1; then
                            sudo dnf install \"$package\"
                        else
                            echo \"$no_toolbox_package_found\" >&2
                        fi
                    "
                fi
                ;;
            eopkg)
                if [ "$primary_toolbox_manager" = "eopkg" ]; then
                    echo "$installing_toolbox"
                    toolbox run bash -c "
                        if eopkg search --name \"^\$pkg\" | grep -Fiq \"$package\"; then
                            sudo eopkg install \"$package\"
                        else
                            echo \"$no_toolbox_package_found\" >&2
                        fi
                    "
                fi
                ;;
            pacman)
                if [[ "$secondary_toolbox_manager" =~ ^(paru|yay)$ ]]; then
                    echo "$installing_toolbox"
                    toolbox run bash -c "
                        if $secondary_toolbox_manager -Ss \"^\$pkg\" > /dev/null 2>&1; then
                            $secondary_toolbox_manager -S \"$package\"
                        else
                            echo \"$no_toolbox_package_found\" >&2
                        fi
                    "
                elif [ "$primary_toolbox_manager" = "pacman" ]; then
                    echo "$installing_toolbox"
                    toolbox run bash -c "
                        if pacman -Ss \"^\$pkg\" > /dev/null 2>&1; then
                            sudo pacman -S \"$package\"
                        else
                            echo \"$no_toolbox_package_found\" >&2
                        fi
                    "
                fi
                ;;
            xbps)
                if [ "$primary_toolbox_manager" = "xbps" ]; then
                    echo "$installing_toolbox"
                    toolbox run bash -c "
                        if xbps-query -Rs \"$package\" | grep -Fiq \"$package\"; then
                            sudo xbps-install -S \"$package\"
                        else
                            echo \"$no_toolbox_package_found\" >&2
                        fi
                    "
                fi
                ;;
            zypper)
                if [ "$primary_toolbox_manager" = "zypper" ]; then
                    echo "$installing_toolbox"
                    toolbox run bash -c "
                        if zypper se --match-exact \"$package\" > /dev/null 2>&1; then
                            sudo zypper in \"$package\"
                        else
                            echo \"$no_toolbox_package_found\" >&2
                        fi
                    "
                fi
                ;;
        esac
    done
}

install() {
    local package="$1"
    if [ $# -eq 0 ]; then
        echo "Enter a package name."
        return 1
    fi

    local managers=(apt dnf eopkg pacman xbps zypper flatpak snap toolbox rpm-ostree)

    for package in "$@"; do
        for manager in "${managers[@]}"; do
            local installing="${green}Installing '$package' using $manager... ${reset}"

            case "$manager" in
                "apt")
                    if [ "$secondary_package_manager" = "nala" ]; then
                        install_nala "$package" "$installing"
                    elif [ "$primary_package_manager" = "apt" ]; then
                        install_apt "$package" "$installing"
                    fi
                    ;;
                "dnf")
                    if [ "$primary_package_manager" = "dnf" ]; then
                        install_dnf "$package" "$installing"
                    fi
                    ;;
                "eopkg")
                    if [ "$primary_package_manager" = "eopkg" ]; then
                        install_eopkg "$package" "$installing"
                    fi
                    ;;
                "pacman")
                    if [[ "$secondary_package_manager" =~ ^(paru|yay)$ ]]; then
                        install_pacman_aur "$package" "$installing"

                    elif [ "$primary_package_manager" = "pacman" ]; then
                        install_pacman_native "$package" "$installing"
                    fi
                    ;;
                "xbps")
                    if [ "$primary_package_manager" = "xbps" ]; then
                        install_xbps "$package" "$installing"
                    fi
                    ;;
                "zypper")
                    if [ "$primary_package_manager" = "zypper" ]; then
                        install_zypper "$package" "$installing"
                    fi
                    ;;
                "flatpak")
                    if [ "$flatpak_installed" -eq 1 ]; then
                        install_flatpak "$package" "$installing" && break 2
                    fi
                    ;;
                "snap")
                    if [ "$snap_installed" -eq 1 ]; then
                        install_snap "$package" "$installing" && break 2
                    fi
                    ;;
                "toolbox")
                    if [ "$toolbox_installed" -eq 1 ]; then
                        install_toolbox "$package" && break 2
                    fi
                    ;;
                "rpm-ostree")
                    if [ "$primary_package_manager" = "rpm-ostree" ]; then
                        install_rpm_ostree "$package" "$installing"
                    fi
                    ;;
            esac
        done
    done
}

