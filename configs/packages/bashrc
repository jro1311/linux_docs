                    if [[ "$secondary_package_manager" =~ ^(paru|yay)$ ]]; then
                        remove_pacman_aur "$package" "$removing"

                    elif [ "$primary_package_manager" = "pacman" ]; then
                        remove_pacman_native "$package" "$removing"
                    fi
                    ;;
                "xbps")
                    if [ "$primary_package_manager" = "xbps" ]; then
                        remove_xbps "$package" "$removing"
                    fi
                    ;;
                "zypper")
                    if [ "$primary_package_manager" = "zypper" ]; then
                        remove_zypper "$package" "$removing"
                    fi
                    ;;
                "flatpak")
                    if [ "$flatpak_installed" -eq 1 ]; then
                        remove_flatpak "$package" "$removing" && break 2
                    fi
                    ;;
                "snap")
                    if [ "$snap_installed" -eq 1 ]; then
                        remove_snap "$package" "$removing" && break 2
                    fi
                    ;;
                "toolbox")
                    if [ "$toolbox_installed" -eq 1 ]; then
                        remove_toolbox "$package" && break 2
                    fi
                    ;;
                "rpm-ostree")
                    if [ "$primary_package_manager" = "rpm-ostree" ]; then
                        remove_rpm_ostree "$package" "$removing"
                    fi
                    ;;
            esac
        done
    done
}

