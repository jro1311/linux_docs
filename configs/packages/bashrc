update_bootloader() {
    local loaders=(grub limine systemd-boot)
    
    for loader in "${loaders[@]}"; do
        case "$loader" in
            "grub")
                if command -v update-grub > /dev/null 2>&1; then
                    echo "${green}Updating $loader... ${reset}"
                    sudo update-grub
                    
                elif command -v grub2-mkconfig > /dev/null 2>&1; then
                    echo "${green}Updating $loader... ${reset}"
                    sudo grub2-mkconfig -o /boot/grub2/grub.cfg
                    
                elif command -v grub-mkconfig > /dev/null 2>&1; then
                    echo "${green}Updating $loader... ${reset}"
                    sudo grub-mkconfig -o /boot/grub/grub.cfg
                fi
                ;;
            "limine")
                if command -v limine-update > /dev/null 2>&1; then
                    echo "${green}Updating $loader... ${reset}"
                    sudo limine-update
                fi
                ;;
            "systemd-boot")
                if find /boot/efi/EFI -name "*systemd-boot*.efi" > /dev/null 2>&1; then
                    echo "${green}Updating $loader... ${reset}"
                    sudo bootctl update
                fi
                ;;
        esac
    done
}

upgrade() {
    local managers=(apt dnf pacman paru yay xbps zypper flatpak snap distrobox toolbox waydroid cinnamon-spice-updater rpm-ostree)
    
    for manager in "${managers[@]}"; do
        case "$manager" in
            "apt")
                if command -v nala > /dev/null 2>&1; then
                    echo "${green}Upgrading system using nala... ${reset}"
                    sudo nala upgrade
                    
                elif command -v apt > /dev/null 2>&1; then
                    echo "${green}Upgrading system using $manager... ${reset}"
                    sudo apt update && sudo apt upgrade
                fi
                ;;
            "dnf")
                if command -v dnf > /dev/null 2>&1; then
                    echo "${green}Upgrading system using $manager... ${reset}"
                    sudo dnf upgrade
                fi
                ;;
            "pacman")
                if command -v pacman > /dev/null 2>&1; then
                    echo "${green}Upgrading system using $manager... ${reset}"
                    sudo pacman -Syu
                fi
                ;;
            "paru")
                if command -v paru > /dev/null 2>&1; then
                    echo "${green}Upgrading system using $manager... ${reset}"
                    paru -Syu
                fi
                ;;
            "yay")
                if command -v yay > /dev/null 2>&1; then
                    echo "${green}Upgrading system using $manager... ${reset}"
                    yay -Syu
                fi
                ;;
            "xbps")
                if command -v xbps-install > /dev/null 2>&1; then
                    echo "${green}Upgrading system using $manager... ${reset}"
                    sudo xbps-install -Su xbps && sudo xbps-install -u
                fi
                ;;
            "zypper")
                if command -v zypper > /dev/null 2>&1; then
                    echo "${green}Upgrading system using $manager... ${reset}"
                    if [ "$os" = "opensuse-tumbleweed" ] || [ "$os" = "opensuse-slowroll" ]; then
                        sudo zypper ref && sudo zypper dup
                        
                    elif [ "$os" = "opensuse-leap" ]; then
                        sudo zypper ref && sudo zypper up
                    fi
                fi
                ;;
            "flatpak")
                if command -v flatpak > /dev/null 2>&1; then
                    echo "${green}Upgrading $manager... ${reset}"
                    flatpak update
                fi
                ;;
            "snap")
                if command -v snap > /dev/null 2>&1; then
                    echo "${green}Upgrading $manager... ${reset}"
                    
                    read -r -p "Upgrade $manager (Y/n)? " answer
                    answer="${answer:-y}"
                    if [[ "$answer" == [Yy] ]]; then
                        sudo snap refresh
                    fi
                fi
                ;;
            "distrobox")
                if command -v distrobox > /dev/null 2>&1; then
                    echo "${green}Upgrading $manager... ${reset}"
                    distrobox-upgrade --all
                fi
                ;;
            "toolbox")
                if command -v toolbox > /dev/null 2>&1; then
                    echo "${green}Upgrading $manager... ${reset}"
                    if toolbox run command -v dnf > /dev/null 2>&1; then
                        toolbox run sudo dnf upgrade
                    
                    elif toolbox run command -v pacman > /dev/null 2>&1; then
                        toolbox run sudo pacman -Syu
                    
                    elif toolbox run command -v zypper > /dev/null 2>&1; then
                        toolbox run sudo zypper ref && sudo zypper dup
                    fi
                fi
                ;;
            "waydroid")
                if command -v waydroid > /dev/null 2>&1; then
                    echo "${green}Upgrading $manager... ${reset}"
                    
                    read -r -p "Upgrade $manager (Y/n)? " answer
                    answer="${answer:-y}"
                    if [[ "$answer" == [Yy] ]]; then
                        sudo waydroid upgrade
                    fi
                fi
                ;;
            "cinnamon-spice-updater")
                if command -v cinnamon-spice-updater > /dev/null 2>&1; then
                    echo "${green}Upgrading Cinnamon Spices... ${reset}"
                    cinnamon-spice-updater --update-all
                fi
                ;;
            "rpm-ostree")
                if command -v rpm-ostree > /dev/null 2>&1; then
                    echo "${green}Upgrading system using $manager... ${reset}"
                    sudo rpm-ostree upgrade
                fi
                ;;
        esac
    done
}
