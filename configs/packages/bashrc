update_bootloader() {
    local loaders=(grub limine systemd-boot)
    
    for loader in "${loaders[@]}"; do
        case "$loader" in
            "grub")
                if command -v update-grub > /dev/null 2>&1; then
                    echo "${green}Updating $loader... ${reset}"
                    sudo update-grub
                    
                elif command -v grub2-mkconfig > /dev/null 2>&1; then
                    echo "${green}Updating $loader... ${reset}"
                    sudo grub2-mkconfig -o /boot/grub2/grub.cfg
                    
                elif command -v grub-mkconfig > /dev/null 2>&1; then
                    echo "${green}Updating $loader... ${reset}"
                    sudo grub-mkconfig -o /boot/grub/grub.cfg
                fi
                ;;
            "limine")
                if command -v limine-update > /dev/null 2>&1; then
                    echo "${green}Updating $loader... ${reset}"
                    sudo limine-update
                fi
                ;;
            "systemd-boot")
                if find /boot/efi/EFI -name "*systemd-boot*.efi" > /dev/null 2>&1; then
                    echo "${green}Updating $loader... ${reset}"
                    sudo bootctl update
                fi
                ;;
        esac
    done
}

upgrade() {
    local managers=(apt dnf pacman xbps zypper flatpak snap distrobox toolbox waydroid cinnamon-spice-updater fwupdmgr rpm-ostree)
    
    for manager in "${managers[@]}"; do
        case "$manager" in
            "apt")
                if command -v nala > /dev/null 2>&1; then
                    echo "${green}Upgrading system using $manager... ${reset}"
                    sudo nala upgrade --full

                elif command -v apt > /dev/null 2>&1; then
                    echo "${green}Upgrading system using $manager... ${reset}"
                    sudo apt update && sudo apt upgrade
                fi
                ;;
            "dnf")
                if command -v dnf > /dev/null 2>&1; then
                    echo "${green}Upgrading system using $manager... ${reset}"
                    sudo dnf upgrade
                fi
                ;;
            "pacman")
                if command -v paru > /dev/null 2>&1; then
                    echo "${green}Upgrading system using $manager... ${reset}"
                    paru -Syu

                elif command -v yay > /dev/null 2>&1; then
                    echo "${green}Upgrading system using $manager... ${reset}"
                    yay -Syu

                elif command -v pacman > /dev/null 2>&1; then
                    echo "${green}Upgrading system using $manager... ${reset}"
                    sudo pacman -Syu
                fi
                ;;
            "xbps")
                if command -v xbps-install > /dev/null 2>&1; then
                    echo "${green}Upgrading system using $manager... ${reset}"
                    sudo xbps-install -Su xbps && sudo xbps-install -u
                fi
                ;;
            "zypper")
                if command -v zypper > /dev/null 2>&1; then
                    echo "${green}Upgrading system using $manager... ${reset}"
                    if [ "$os" = "opensuse-tumbleweed" ] || [ "$os" = "opensuse-slowroll" ]; then
                        sudo zypper ref && sudo zypper dup
                        
                    elif [ "$os" = "opensuse-leap" ]; then
                        sudo zypper ref && sudo zypper up
                    fi
                fi
                ;;
            "flatpak")
                if command -v flatpak > /dev/null 2>&1; then
                    echo "${green}Updating $manager packages... ${reset}"
                    flatpak update
                fi
                ;;
            "snap")
                if command -v snap > /dev/null 2>&1; then
                    echo "${green}Updating $manager packages... ${reset}"
                    
                    while true; do
                        read -r -p "Confirm update? [Y/n]: " answer
                        answer="${answer:-y}"

                        case "$answer" in
                            [Yy])
                                sudo snap refresh
                                break
                                ;;
                            [Nn])
                                break
                                ;;
                            *)
                                echo "Enter a 'y' or 'n'."
                                ;;
                        esac
                    done
                fi
                ;;
            "distrobox")
                if command -v distrobox > /dev/null 2>&1; then
                    echo "${green}Upgrading $manager... ${reset}"
                    distrobox-upgrade --all
                fi
                ;;
            "toolbox")
                if command -v toolbox > /dev/null 2>&1; then

                    local toolbox_managers=(apt dnf pacman xbps zypper)

                    for toolbox_manager in "${toolbox_managers[@]}"; do
                        case "$toolbox_manager" in
                            "apt")
                                if toolbox run command -v apt > /dev/null 2>&1; then
                                    echo "${green}Upgrading $manager with $toolbox_manager... ${reset}"

                                    if toolbox run command -v nala > /dev/null 2>&1; then
                                        toolbox run sudo nala upgrade --full

                                    else
                                        toolbox run sudo apt update && toolbox run sudo apt upgrade
                                    fi
                                fi
                                ;;
                            "dnf")
                                if toolbox run command -v dnf > /dev/null 2>&1; then
                                    echo "${green}Upgrading $manager with $toolbox_manager... ${reset}"
                                    toolbox run sudo dnf upgrade
                                fi
                                ;;
                            "pacman")
                                if toolbox run command -v paru > /dev/null 2>&1; then
                                    echo "${green}Upgrading $manager with $toolbox_manager... ${reset}"
                                    toolbox run paru -Syu

                                elif toolbox run command -v yay > /dev/null 2>&1; then
                                    echo "${green}Upgrading $manager with $toolbox_manager... ${reset}"
                                    toolbox run yay -Syu

                                elif toolbox command -v pacman > /dev/null 2>&1; then
                                    echo "${green}Upgrading $manager with $toolbox_manager... ${reset}"
                                    toolbox run sudo pacman -Syu
                                fi
                                ;;
                            "xbps")
                                if toolbox run command -v xbps-install > /dev/null 2>&1; then
                                    echo "${green}Upgrading $manager with $toolbox_manager... ${reset}"
                                    toolbox run sudo xbps-install -Su xbps && toolbox run sudo xbps-install -u
                                fi
                                ;;
                            "zypper")
                                if toolbox run command -v zypper > /dev/null 2>&1; then
                                    echo "${green}Upgrading $manager with $toolbox_manager... ${reset}"
                                    toolbox run sudo zypper ref && sudo zypper dup
                                fi
                                ;;
                        esac
                    done
                fi
                ;;
            "waydroid")
                if command -v waydroid > /dev/null 2>&1; then
                    echo "${green}Upgrading $manager... ${reset}"
                    
                    while true; do
                        read -r -p "Confirm upgrade? [Y/n]: " answer
                        answer="${answer:-y}"

                        case "$answer" in
                            [Yy])
                                sudo waydroid upgrade
                                break
                                ;;
                            [Nn])
                                break
                                ;;
                            *)
                                echo "Enter a 'y' or 'n'."
                                ;;
                        esac
                    done
                fi
                ;;
            "cinnamon-spice-updater")
                if command -v cinnamon-spice-updater > /dev/null 2>&1; then
                    echo "${green}Updating Cinnamon Spices... ${reset}"
                    cinnamon-spice-updater --update-all
                fi
                ;;
            "fwupdmgr")
                if command -v fwupdmgr > /dev/null 2>&1; then
                    echo "${green}Updating firmware... ${reset}"

                    if ! fwupdmgr refresh 2>&1 | grep -Fq "Metadata is up to date"; then
                        fwupdmgr update
                    else
                        echo "Firmware is up to date."
                    fi
                fi
                ;;
            "rpm-ostree")
                if command -v rpm-ostree > /dev/null 2>&1; then
                    echo "${green}Upgrading system using $manager... ${reset}"
                    sudo rpm-ostree upgrade
                fi
                ;;
        esac
    done
}
