green=$(tput setaf 2)
yellow=$(tput setaf 3)
blue=$(tput setaf 4)
reset=$(tput sgr0)

## Functions
clean() {
    local managers=(apt dnf pacman xbps zypper flatpak toolbox rpm-ostree)
    
    for manager in "${managers[@]}"; do
        case "$manager" in
            "apt")
                if command -v nala > /dev/null 2>&1; then
                    echo "${red}Cleaning system using $manager... ${reset}"
                    sudo nala clean && sudo nala autoremove

                elif command -v apt > /dev/null 2>&1; then
                    echo "${red}Cleaning system using $manager... ${reset}"
                    sudo apt clean && sudo apt autoremove
                fi
                ;;
            "dnf")
                if command -v dnf > /dev/null 2>&1; then
                    echo "${red}Cleaning system using $manager... ${reset}"
                    sudo dnf autoremove
                fi
                ;;
            "pacman")
                if command -v paru > /dev/null 2>&1; then
                    echo "${red}Cleaning system using $manager... ${reset}"
                    paru -Rns "$(paru -Qdtq)" && paru -Sc

                elif command -v yay > /dev/null 2>&1; then
                    echo "${red}Cleaning system using $manager... ${reset}"
                    yay -Rns "$(yay -Qdtq)" && yay -Sc

                elif command -v pacman > /dev/null 2>&1; then
                    echo "${red}Cleaning system using $manager...${reset}"
                    sudo pacman -Rns "$(pacman -Qdtq)" && sudo pacman -Sc
                fi
                ;;
            "xbps")
                if command -v xbps-remove > /dev/null 2>&1; then
                    echo "${red}Cleaning system using $manager... ${reset}"
                    sudo xbps-remove -o
                fi
                ;;
            "zypper")
                if command -v zypper > /dev/null 2>&1; then
                    echo "${red}Cleaning system using $manager... ${reset}"
                    sudo zypper clean
                fi
                ;;
            "flatpak")
                if command -v flatpak > /dev/null 2>&1; then
                    echo "${red}Cleaning system using $manager... ${reset}"
                    flatpak uninstall --unused
                fi
                ;;
            "toolbox")
                if command -v toolbox > /dev/null 2>&1; then

                    local toolbox_managers=(apt dnf pacman xbps zypper)

                    for toolbox_manager in "${toolbox_managers[@]}"; do
                        case "$toolbox_manager" in
                            "apt")
                                if toolbox run command -v nala > /dev/null 2>&1; then
                                    echo "${red}Cleaning system using $manager with $toolbox_manager... ${reset}"
                                    toolbox run sudo nala clean && toolbox run sudo nala autoremove

                                elif toolbox run command -v apt > /dev/null 2>&1; then
                                    echo "${red}Cleaning system using $manager with $toolbox_manager... ${reset}"
                                    toolbox run sudo apt clean && toolbox run sudo apt autoremove
                                fi
                                ;;
                            "dnf")
                                if toolbox run command -v dnf > /dev/null 2>&1; then
                                    echo "${red}Cleaning system using $manager with $toolbox_manager... ${reset}"
                                    toolbox run sudo dnf autoremove
                                fi
                                ;;
                            "pacman")
                                if toolbox run command -v paru > /dev/null 2>&1; then
                                    echo "${red}Cleaning system using $manager with $toolbox_manager... ${reset}"
                                    toolbox run paru -Rns "$(paru -Qdtq)" && toolbox run paru -Sc

                                elif toolbox run command -v yay > /dev/null 2>&1; then
                                    echo "${red}Cleaning system using $manager with $toolbox_manager... ${reset}"
                                    toolbox run yay -Rns "$(yay -Qdtq)" && toolbox run yay -Sc

                                elif toolbox run command -v pacman > /dev/null 2>&1; then
                                    echo "${red}Cleaning system using $manager with $toolbox_manager... ${reset}"
                                    toolbox run sudo pacman -Rns "$(pacman -Qdtq)" && toolbox run sudo pacman -Sc
                                fi
                                ;;
                            "xbps")
                                if toolbox run command -v xbps-remove > /dev/null 2>&1; then
                                    echo "${red}Cleaning system using $manager with $toolbox_manager... ${reset}"
                                    toolbox run sudo xbps-remove -o
                                fi
                                ;;
                            "zypper")
                                if toolbox run command -v zypper > /dev/null 2>&1; then
                                    echo "${red}Cleaning system using $manager with $toolbox_manager... ${reset}"
                                    toolbox run sudo zypper clean
                                fi
                                ;;
                        esac
                    done
                fi
                ;;
            "rpm-ostree")
                if command -v rpm-ostree > /dev/null 2>&1; then
                    echo "${red}Cleaning system using $manager... ${reset}"
                    sudo rpm-ostree cleanup
                fi
                ;;
        esac
    done
}

install() {
    if [ $# -eq 0 ]; then
        echo "Enter a package name."
        return 1
    fi

    local managers=(apt dnf pacman xbps zypper flatpak snap toolbox rpm-ostree)
    
    for package in "$@"; do
        for manager in "${managers[@]}"; do
            case "$manager" in
                "apt")
                    if command -v nala > /dev/null 2>&1; then
                        if apt list "$package" 2>/dev/null | grep -Fiq "$package"; then
                            echo "${green}Installing $package using $manager... ${reset}"
                            sudo nala install "$package"

                        else
                            echo "${yellow}$manager: '$package' not found ${reset}" >&2
                        fi

                    elif command -v apt > /dev/null 2>&1; then
                        if apt list "$package" 2>/dev/null | grep -Fiq "$package"; then
                            echo "${green}Installing $package using $manager... ${reset}"
                            sudo apt install "$package"
                            
                        else
                            echo "${yellow}$manager: '$package' not found ${reset}" >&2
                        fi
                    fi
                    ;;
                "dnf")
                    if command -v dnf > /dev/null 2>&1; then
                        if dnf list --available "$package" > /dev/null 2>&1; then
                            echo "${green}Installing $package using $manager... ${reset}"
                            sudo dnf install "$package"
                            
                        else
                            echo "${yellow}$manager: '$package' not found ${reset}" >&2
                        fi
                    fi
                    ;;
                "pacman")
                    if command -v paru > /dev/null 2>&1; then
                        if paru -Ss "$package" > /dev/null 2>&1; then
                            echo "${green}Installing $package using $manager... ${reset}"
                            paru -S "$package"

                        else
                            echo "${yellow}$manager: '$package' not found ${reset}" >&2
                        fi

                    elif command -v yay > /dev/null 2>&1; then
                        if yay -Ss "$package" > /dev/null 2>&1; then
                            echo "${green}Installing $package using $manager... ${reset}"
                            sudo yay -S "$package"

                        else
                            echo "${yellow}$manager: '$package' not found ${reset}" >&2
                        fi

                    elif command -v pacman > /dev/null 2>&1; then
                        if pacman -Ss "$package" > /dev/null 2>&1; then
                            echo "${green}Installing $package using $manager... ${reset}"
                            sudo pacman -S "$package"
                            
                        else
                            echo "${yellow}$manager: '$package' not found ${reset}" >&2
                        fi
                    fi
                    ;;
                "xbps")
                    if command -v xbps-install > /dev/null 2>&1; then
                        if xbps-query -Rs "$package" > /dev/null 2>&1; then
                            echo "${green}Installing $package using $manager... ${reset}"
                            sudo xbps-install -S "$package"
                            
                        else
                            echo "${yellow}$manager: '$package' not found ${reset}" >&2
                        fi
                    fi
                    ;;
                "zypper")
                    if command -v zypper > /dev/null 2>&1; then
                        if zypper se --match-exact "$package" > /dev/null 2>&1; then
                            echo "${green}Installing $package using $manager... ${reset}"
                            sudo zypper in "$package"
                            
                        else
                            echo "${yellow}$manager: '$package' not found ${reset}" >&2
                        fi
                    fi
                    ;;
                "flatpak")
                    if command -v flatpak > /dev/null 2>&1; then
                        if flatpak search --columns=name,application "$package" | grep -Fiq "$package"; then
                            echo "${green}Installing $package using $manager... ${reset}"
                            flatpak install "$package"
                            
                        else
                            echo "${yellow}$manager: '$package' not found ${reset}" >&2
                        fi
                    fi
                    ;;
                "snap")
                    if command -v snap > /dev/null 2>&1; then 
                        if snap find "$package" | grep -Fiq "$package"; then
                            echo "${green}Installing $package using $manager... ${reset}"
                            
                            while true; do
                                read -r -p "Confirm installation? [Y/n]: " answer
                                answer="${answer:-y}"

                                case "$answer" in
                                    [Yy])
                                        sudo snap install "$package"
                                        break
                                        ;;
                                    [Nn])
                                        break
                                        ;;
                                    *)
                                        echo "Enter a 'y' or 'n'."
                                        ;;
                                esac
                            done
                            
                        else
                            echo "${yellow}$manager: '$package' not found ${reset}" >&2
                        fi
                    fi
                    ;;
                "toolbox")
                    if command -v toolbox > /dev/null 2>&1; then

                        local toolbox_managers=(apt dnf pacman xbps zypper)
                        package_found=false

                        for toolbox_manager in "${toolbox_managers[@]}"; do
                            case "$toolbox_manager" in
                                "apt")
                                    if toolbox run apt list "$package" 2>/dev/null | grep -Fiq "$package"; then
                                        package_found=true
                                        echo "${green}Installing $package using $manager with $toolbox_manager... ${reset}"

                                        if toolbox run command -v nala > /dev/null 2>&1; then
                                            toolbox run sudo nala install "$package"

                                        else
                                            toolbox run sudo apt install "$package"
                                        fi
                                    fi
                                    ;;
                                "dnf")
                                    if toolbox run dnf list --available "$package" > /dev/null 2>&1; then
                                        package_found=true
                                        echo "${green}Installing $package using $manager with $toolbox_manager... ${reset}"
                                        toolbox run sudo dnf install "$package"
                                    fi
                                    ;;
                                "pacman")
                                    if toolbox run paru -Ss "$package" > /dev/null 2>&1; then
                                        package_found=true
                                        echo "${green}Installing $package using $manager with $toolbox_manager... ${reset}"
                                        toolbox run paru -S "$package"

                                    elif toolbox run yay -Ss "$package" > /dev/null 2>&1; then
                                        package_found=true
                                        echo "${green}Installing $package using $manager with $toolbox_manager... ${reset}"
                                        toolbox run yay -S "$package"

                                    elif toolbox run pacman -Ss "$package" > /dev/null 2>&1; then
                                        package_found=true
                                        echo "${green}Installing $package using $manager with $toolbox_manager... ${reset}"
                                        toolbox run sudo pacman -S "$package"
                                    fi
                                    ;;
                                "xbps")
                                    if toolbox run xbps-query -Rs "$package" > /dev/null 2>&1; then
                                        package_found=true
                                        echo "${green}Installing $package using $manager with $toolbox_manager... ${reset}"
                                        toolbox run sudo xbps-install -S "$package"
                                    fi
                                    ;;
                                "zypper")
                                    if toolbox run zypper se --match-exact "$package" > /dev/null 2>&1; then
                                        package_found=true
                                        echo "${green}Installing $package using $manager with $toolbox_manager... ${reset}"
                                        toolbox run sudo zypper in "$package"
                                    fi
                                    ;;
                            esac
                        done

                        if ! $package_found; then
                            echo "${yellow}$manager: '$package' not found ${reset}" >&2
                        fi
                    fi
                    ;;
                "rpm-ostree")
                    if command -v rpm-ostree > /dev/null 2>&1; then 
                        if rpm-ostree list --installed "$package" > /dev/null 2>&1; then
                            echo "${green}Installing $package using $manager... ${reset}"
                            sudo rpm-ostree install "$package"
                            
                        else
                            echo "${yellow}$manager: '$package' not found ${reset}" >&2
                        fi
                    fi
                    ;;
            esac
        done
    done
}

