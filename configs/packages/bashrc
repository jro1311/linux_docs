# Detects the operating system and stores it in a variable

if [ -f /etc/os-release ]; then
    . /etc/os-release
    os="${ID:-unknown}"
    os_like="${ID_LIKE:-$os}"
fi

# Converts the variable into lowercase

os=$(echo "${os:-unknown}" | tr '[:upper:]' '[:lower:]')
os_like=$(echo "$os_like" | tr '[:upper:]' '[:lower:]')

# Functions

clean() {
    if command -v apt > /dev/null 2>&1; then
        if command -v nala > /dev/null 2>&1; then
            sudo nala clean && sudo nala autoremove
        else
            sudo apt clean && sudo apt autoremove
        fi
    elif command -v dnf > /dev/null 2>&1; then
        sudo dnf autoremove
    elif command -v pacman > /dev/null 2>&1; then
        sudo pacman -Rns "$(pacman -Qdtq)" && sudo pacman -Sc
        if command -v paru > /dev/null 2>&1; then
            paru -Rns "$(paru -Qdtq)" && paru -Sc
        elif command -v yay > /dev/null 2>&1; then
            yay -Rns "$(yay -Qdtq)" && yay -Sc
        fi
    elif command -v rpm-ostree > /dev/null 2>&1; then
        sudo rpm-ostree cleanup
    elif command -v xbps-remove > /dev/null 2>&1; then
        sudo xbps-remove -o
    elif command -v zypper > /dev/null 2>&1; then
        sudo zypper clean
    else
        echo "Unsupported package manager"
        return 1
    fi
    
    if command -v flatpak > /dev/null 2>&1; then
        flatpak uninstall --unused
    fi
}

install() {
    for package in "$@"; do
        if [[ -z "$package" ]]; then
            echo "Enter a package name"
            return 1
        fi

        if command -v apt > /dev/null 2>&1; then
            if command -v nala > /dev/null 2>&1; then
                if apt list "$package" > /dev/null 2>&1; then
                    sudo nala install "$package"
                elif command -v flatpak > /dev/null 2>&1; then
                    if flatpak search --columns=name,application "$package" | grep -Fiq "$package"; then
                        flatpak install "$package"
                    fi
                elif command -v snap > /dev/null 2>&1; then
                    if snap find "$package" | grep -Fiq "$package"; then
                        sudo snap install "$package"
                    fi
                else
                    echo "$package not found"
                    return 1
                fi
            else
                if apt list "$package" > /dev/null 2>&1; then
                    sudo apt install "$package"
                elif command -v flatpak > /dev/null 2>&1; then
                    if flatpak search --columns=name,application "$package" | grep -Fiq "$package"; then
                        flatpak install "$package"
                    fi
                elif command -v snap > /dev/null 2>&1; then
