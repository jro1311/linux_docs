# Detects the operating system and stores it in a variable

if [ -f /etc/os-release ]; then
    . /etc/os-release
    os="${ID:-unknown}"
    os_like="${ID_LIKE:-$os}"
fi

# Converts the variable into lowercase

os=$(echo "${os:-unknown}" | tr '[:upper:]' '[:lower:]')
os_like=$(echo "$os_like" | tr '[:upper:]' '[:lower:]')

# Functions

clean() {
    local managers=(apt dnf pacman xbps zypper flatpak snap rpm-ostree)
    
    for manager in "${managers[@]}"; do
        case "$manager" in
            "apt")
                if command -v nala > /dev/null 2>&1; then
                    sudo nala clean && sudo nala autoremove
                elif command -v apt > /dev/null 2>&1; then
                    sudo apt clean && sudo apt autoremove
                fi
                ;;
            "dnf")
                if command -v dnf > /dev/null 2>&1; then
                    sudo dnf autoremove
                fi
                ;;
            "pacman")
                if command -v pacman > /dev/null 2>&1; then
                    sudo pacman -Rns "$(pacman -Qdtq)" && sudo pacman -Sc
                fi
            
                if command -v paru > /dev/null 2>&1; then
                    paru -Rns "$(paru -Qdtq)" && paru -Sc
                elif command -v yay > /dev/null 2>&1; then
                    yay -Rns "$(yay -Qdtq)" && yay -Sc
                fi
                ;;
            "xbps")
                if command -v xbps-remove > /dev/null 2>&1; then
                    sudo xbps-remove -o
                fi
                ;;
            "zypper")
                if command -v zypper > /dev/null 2>&1; then
                    sudo zypper clean
                fi
                ;;
            "flatpak")
                if command -v flatpak > /dev/null 2>&1; then
                    flatpak uninstall --unused
                fi
                ;;
            "snap")
                if command -v snap > /dev/null 2>&1; then
                fi
                ;;
            "rpm-ostree")
                if command -v rpm-ostree > /dev/null 2>&1; then
                    sudo rpm-ostree cleanup
                fi
                ;;
        esac
    done
}

install() {
    for package in "$@"; do
        if [[ -z "$package" ]]; then
            echo "Enter a package name"
            return 1
        fi
    done

    local managers=(apt dnf pacman xbps zypper flatpak snap rpm-ostree)
    
    for package in "$@"; do
        for manager in "${managers[@]}"; do
            case "$manager" in
                "apt")
                    if command -v nala > /dev/null 2>&1 && apt list "$package" 2>/dev/null | grep -Fiq "$package"; then
                        sudo nala install "$package"
                    elif command -v apt > /dev/null 2>&1 && apt list "$package" 2>/dev/null | grep -Fiq "$package"; then
                        sudo apt install "$package"
                    fi
                    ;;
                "dnf")
                    if command -v dnf > /dev/null 2>&1 && dnf list --installed "$package" > /dev/null 2>&1; then
                        sudo dnf install "$package"
                    fi
                    ;;
                "pacman")
                    if command -v pacman > /dev/null 2>&1 && pacman -Ss "$package" > /dev/null 2>&1; then
                        sudo pacman -S "$package"
                    elif command -v paru > /dev/null 2>&1 && paru -Ss "$package" > /dev/null 2>&1; then
                        paru -S "$package"
                    elif command -v yay > /dev/null 2>&1 && yay -Ss "$package" > /dev/null 2>&1; then
                        yay -S "$package"
                    fi
                    ;;
                "xbps")
                    if command -v xbps-install > /dev/null 2>&1 && xbps-query -Rs "$package" > /dev/null 2>&1; then
                        sudo xbps-install -S "$package"
                    fi
                    ;;
                "zypper")
                    if command -v zypper > /dev/null 2>&1 && zypper se "$package" > /dev/null 2>&1; then
                        sudo zypper in "$package"
                    fi
                    ;;
                "flatpak")
                    if command -v flatpak > /dev/null 2>&1 && flatpak search --columns=name,application "$package" | grep -Fiq "$package"; then
                        flatpak install "$package"
                    fi
                    ;;
                "snap")
                    if command -v snap > /dev/null 2>&1 && snap find "$package" | grep -Fiq "$package"; then
                        sudo snap install "$package"
                    fi
                    ;;
                "rpm-ostree")
                    if command -v rpm-ostree > /dev/null 2>&1 && rpm-ostree list --installed "$package" > /dev/null 2>&1; then
                        sudo rpm-ostree install "$package"
                    fi
                    ;;
            esac
        done
    done
}

remove() {
    for package in "$@"; do
        if [[ -z "$package" ]]; then
            echo "Enter a package name"
            return 1
        fi
    done

    local managers=(apt dnf pacman xbps zypper flatpak snap rpm-ostree)
    
    for package in "$@"; do
        for manager in "${managers[@]}"; do
            case "$manager" in
                "apt")
                    if command -v nala > /dev/null 2>&1 && apt list --installed > /dev/null 2>&1; then
                        sudo nala remove "$package"
                    elif command -v apt > /dev/null 2>&1 && apt list --installed > /dev/null 2>&1; then
                        sudo apt remove "$package"
                    fi
                    ;;
                "dnf")
                    if command -v dnf > /dev/null 2>&1 && dnf list --installed "$package" > /dev/null 2>&1; then
                        sudo dnf remove "$package"
                    fi
                    ;;
                "pacman")
                    if command -v pacman > /dev/null 2>&1 && pacman -Qs "$package" > /dev/null 2>&1; then
                        sudo pacman -Rs "$package"
                    elif command -v paru > /dev/null 2>&1 && paru -Qs "$package" > /dev/null 2>&1; then
                        paru -Rs "$package"
                    elif command -v yay > /dev/null 2>&1 && yay -Qs "$package" > /dev/null 2>&1; then
                        yay -Rs "$package"
                    fi
                    ;;
                "xbps")
                    if command -v xbps-remove > /dev/null 2>&1 && xbps-query -s "$package" > /dev/null 2>&1; then
                        sudo xbps-remove -R "$package"
                    fi
                    ;;
                "zypper")
                    if command -v zypper > /dev/null 2>&1 && zypper se -i "$package" > /dev/null 2>&1; then
                        sudo zypper rm --clean-deps "$package"
                    fi
                    ;;
                "flatpak")
                    if command -v flatpak > /dev/null 2>&1 && flatpak list --columns=name,application | grep -Fiq "$package"; then
                        flatpak remove "$package"
                    fi
                    ;;
                "snap")
                    if command -v snap > /dev/null 2>&1 && snap list | grep -Fiq "$package"; then
                        sudo snap remove "$package"
                    fi
                    ;;
                "rpm-ostree")
                    if command -v rpm-ostree > /dev/null 2>&1 && rpm-ostree list --installed "$package" > /dev/null 2>&1; then
                        sudo rpm-ostree remove "$package"
                    fi
                    ;;
            esac
        done
    done
}

search() {
    for package in "$@"; do
        if [[ -z "$package" ]]; then
            echo "Enter a package name"
            return 1
        fi
    done

    local managers=(apt dnf pacman xbps zypper flatpak snap rpm-ostree)
    
    for package in "$@"; do
        for manager in "${managers[@]}"; do
            case "$manager" in
                "apt")
                    if command -v nala > /dev/null 2>&1; then
                        echo "Searching using nala..."
                        nala search "$package"
                    elif command -v apt > /dev/null 2>&1; then
                        echo "Searching using apt..."
                        apt search "$package"
                    fi
                    ;;
                "dnf")
                    if command -v dnf > /dev/null 2>&1; then
                        echo "Searching using dnf..."
                        dnf search "$package"
                    fi
                    ;;
                "pacman")
                    if command -v pacman > /dev/null 2>&1; then
                        echo "Searching using pacman..."
                        pacman -Ss "$package"
                    fi
                    
                    if command -v paru > /dev/null 2>&1; then
                        echo "Searching using paru..."
                        paru -Ss "$package"
                    elif command -v yay > /dev/null 2>&1; then
                        echo "Searching using yay..."
                        yay -Ss "$package"
                    fi
                    ;;
                "xbps")
                    if command -v xbps-query > /dev/null 2>&1; then
                        echo "Searching using xbps-query..."
                        sudo xbps-query -Rs "$package"
                    fi
                    ;;
                "zypper")
                    if command -v zypper > /dev/null 2>&1; then
                        echo "Searching using zypper..."
                        zypper se "$package"
                    fi
                    ;;
                "flatpak")
                    if command -v flatpak > /dev/null 2>&1; then
                        echo "Searching using flatpak..."
                        flatpak search "$package"
                    fi
                    ;;
                "snap")
                    if command -v snap > /dev/null 2>&1; then
                        echo "Searching using snap..."
                        snap find "$package"
                    fi
                    ;;
                "rpm-ostree")
                    if command -v rpm-ostree > /dev/null 2>&1; then
                        echo "Searching using rpm-ostree..."
                        rpm-ostree search "$package"
                    fi
                    ;;
            esac
        done
    done
}

update_grub() {
    if command -v update-grub > /dev/null 2>&1; then
        sudo update-grub
    elif command -v grub2-mkconfig > /dev/null 2>&1; then
        sudo grub2-mkconfig -o /boot/grub2/grub.cfg
    elif command -v grub-mkconfig > /dev/null 2>&1; then
        sudo grub-mkconfig -o /boot/grub/grub.cfg
    else
        echo "GRUB not detected"
        return 1
    fi
}

upgrade() {
    local managers=(apt dnf pacman xbps zypper flatpak snap rpm-ostree)
    
    for manager in "${managers[@]}"; do
        case "$manager" in
            "apt")
                if command -v nala > /dev/null 2>&1; then
                    sudo nala upgrade
                elif command -v apt > /dev/null 2>&1; then
                    sudo apt update && sudo apt upgrade
                fi
                ;;
            "dnf")
                if command -v dnf > /dev/null 2>&1; then
                    sudo dnf upgrade
                fi
                ;;
            "pacman")
                if command -v pacman > /dev/null 2>&1; then
                    sudo pacman -Syu
                fi
            
                if command -v paru > /dev/null 2>&1; then
                    paru -Syu
                elif command -v yay > /dev/null 2>&1; then
                    yay -Syu
                fi
                ;;
            "xbps")
                if command -v xbps-query > /dev/null 2>&1; then
                    sudo xbps-install -Su xbps && sudo xbps-install -u
                fi
                ;;
            "zypper")
                if command -v zypper > /dev/null 2>&1; then
                    if [ "$os" = "opensuse-tumbleweed" ] || [ "$os" = "opensuse-slowroll" ]; then
                        sudo zypper ref && sudo zypper dup
                    elif [ "$os" = "opensuse-leap" ]; then
                        sudo zypper ref && sudo zypper up
                    fi
                fi
                ;;
            "flatpak")
                if command -v flatpak > /dev/null 2>&1; then
                    flatpak update
                fi
                ;;
            "snap")
                if command -v snap > /dev/null 2>&1; then
                    sudo snap refresh
                fi
                ;;
            "rpm-ostree")
                if command -v rpm-ostree > /dev/null 2>&1; then
                    sudo rpm-ostree upgrade
                fi
                ;;
        esac
    done
}
