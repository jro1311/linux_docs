# Detects the operating system and stores it in a variable

if [ -f /etc/os-release ]; then
    . /etc/os-release
    os="${ID:-unknown}"
    os_like="${ID_LIKE:-$os}"
fi

# Converts the variable into lowercase

os=$(echo "${os:-unknown}" | tr '[:upper:]' '[:lower:]')
os_like=$(echo "$os_like" | tr '[:upper:]' '[:lower:]')

# Functions

clean() {
    if command -v apt &> /dev/null; then
        if command -v nala &> /dev/null; then
            sudo nala clean && sudo nala autoremove
        else
            sudo apt clean && sudo apt autoremove
        fi
    elif command -v dnf &> /dev/null; then
        sudo dnf autoremove
    elif command -v pacman &> /dev/null; then
        sudo pacman -Rns "$(pacman -Qdtq)" && sudo pacman -Sc
        if command -v paru &> /dev/null; then
            paru -Rns "$(paru -Qdtq)" && paru -Sc
        elif command -v yay &> /dev/null; then
            yay -Rns "$(yay -Qdtq)" && yay -Sc
        fi
    elif command -v rpm-ostree &> /dev/null; then
        sudo rpm-ostree cleanup
    elif command -v xbps-remove &> /dev/null; then
        sudo xbps-remove "$(xbps-query -Oo)"
    elif command -v zypper &> /dev/null; then
        sudo zypper clean
    fi
    
    if command -v flatpak &> /dev/null; then
        flatpak uninstall --unused
    fi
}

install() {
    local package="$1"
    if [[ -z "$package" ]]; then
        echo "Enter a package name"
        return 1
    fi

    if command -v apt &> /dev/null; then
        if command -v nala &> /dev/null; then
            if nala search "$package" | grep -q "$package"; then
                sudo nala install "$package"
            elif flatpak search "$package" | grep -q "$package"; then
                flatpak install "$package"
            elif snap find "$package" | grep -q "$package"; then
                sudo snap install "$package"
            else
                echo "$package not found"
            fi
        else
            if apt search "$package" | grep -q "$package"; then
                sudo apt install "$package"
            elif flatpak search "$package" | grep -q "$package"; then
                flatpak install "$package"
            elif snap find "$package" | grep -q "$package"; then
                sudo snap install "$package"
            else
                echo "$package not found"
            fi
        fi
    elif command -v dnf &> /dev/null; then
        if dnf search "$package" | grep -q "$package"; then
            sudo dnf install "$package"
        elif flatpak search "$package" | grep -q "$package"; then
            flatpak install "$package"
        elif snap find "$package" | grep -q "$package"; then
            sudo snap install "$package"
        else
            echo "$package not found"
        fi
    elif command -v pacman &> /dev/null; then
        if pacman -Ss "$package" &> /dev/null; then
            sudo pacman -S "$package"
        elif flatpak search "$package" | grep -q "$package"; then
            flatpak install "$package"
        elif snap find "$package" | grep -q "$package"; then
            sudo snap install "$package"
        else
            echo "$package not found"
        fi
    elif command -v rpm-ostree &> /dev/null; then
        if flatpak search "$package" | grep -q "$package"; then
            flatpak install "$package"
        elif snap find "$package" | grep -q "$package"; then
            snap install "$package"
        elif rpm-ostree search "$package" | grep -q "$package"; then
            sudo rpm-ostree install "$package"
        else
            echo "$package not found"
        fi
    elif command -v xbps-install &> /dev/null; then
        if xbps-query -R "$package" | grep -q "$package"; then
            sudo xbps-install "$package"
        elif flatpak search "$package" | grep -q "$package"; then
            flatpak install "$package"
        elif snap find "$package" | grep -q "$package"; then
            sudo snap install "$package"
        else
            echo "$package not found"
        fi
    elif command -v zypper &> /dev/null; then
        if zypper se "$package" | grep -q "$package"; then
            sudo zypper in "$package"
        elif flatpak search "$package" | grep -q "$package"; then
            flatpak install "$package"
        elif snap find "$package" | grep -q "$package"; then
            sudo snap install "$package"
        else
            echo "$package not found"
        fi
    else
        echo "Unsupported package manager"
        return 1
    fi
}

off() {
    if ps -p 1 -o comm= | grep -q "systemd"; then
        systemctl poweroff
    else
        poweroff
    fi
}

reboot() {
    if ps -p 1 -o comm= | grep -q "systemd"; then
        systemctl reboot
    else
        reboot
    fi
}

remove() {
    local package="$1"
    if [[ -z "$package" ]]; then
        echo "Enter a package name"
        return 1
    fi

    if command -v apt &> /dev/null; then
        if command -v nala &> /dev/null; then
            if nala list --installed | grep -q "$package" &> /dev/null; then
                sudo nala remove "$package"
            elif flatpak list | grep -q "$package" &> /dev/null; then
                flatpak remove "$package"
            elif snap list | grep -q "$package" &> /dev/null; then
                sudo snap remove "$package"
            else
                echo "$package not found"
            fi
        else
            if apt list --installed | grep -q "$package" &> /dev/null; then
                sudo apt remove "$package"
            elif flatpak list | grep -q "$package" &> /dev/null; then
                flatpak remove "$package"
            elif snap list | grep -q "$package" &> /dev/null; then
                sudo snap remove "$package"
            else
                echo "$package not found"
            fi
        fi
    elif command -v dnf &> /dev/null; then
        if dnf list --installed | grep "$package" &> /dev/null; then
            sudo dnf remove "$package"
        elif flatpak list | grep -q "$package" &> /dev/null; then
            flatpak remove "$package"
        elif snap list | grep -q "$package" &> /dev/null; then
            sudo snap remove "$package"
        else
            echo "$package not found"
        fi
    elif command -v pacman &> /dev/null; then
        if pacman -Qs "$package" &> /dev/null; then
            sudo pacman -Rs "$package"
        elif flatpak list | grep -q "$package" &> /dev/null; then
            flatpak remove "$package"
        elif snap list | grep -q "$package" &> /dev/null; then
            sudo snap remove "$package"
        else
            echo "$package not found"
        fi
    elif command -v rpm-ostree &> /dev/null; then
        if flatpak list | grep -q "$package" &> /dev/null; then
            flatpak remove "$package"
        elif snap list | grep -q "$package" &> /dev/null; then
            snap remove "$package"
        elif rpm-ostree list --installed | grep -q "$package" &> /dev/null; then
            sudo rpm-ostree remove "$package"
        else
            echo "$package not found"
        fi
    elif command -v xbps-query &> /dev/null; then
        if xbps-query -l "$package" | grep -q "$package" &> /dev/null; then
            sudo xbps-remove -R "$package"
        elif flatpak list | grep -q "$package" &> /dev/null; then
            flatpak remove "$package"
        elif snap list | grep -q "$package" &> /dev/null; then
            sudo snap remove "$package"
        else
            echo "$package not found"
        fi
    elif command -v zypper &> /dev/null; then
        if zypper se -i | grep -q "$package" &> /dev/null; then
            sudo zypper rm --clean-deps "$package"
        elif flatpak list | grep -q "$package" &> /dev/null; then
            flatpak remove "$package"
        elif snap list | grep -q "$package"&> /dev/null; then
            sudo snap remove "$package"
        else
            echo "$package not found"
        fi
    else
        echo "Unsupported package manager"
        return 1
    fi
}

search() {
    local package="$1"
    if [[ -z "$package" ]]; then
        echo "Enter a package name"
        return 1
    fi

    if command -v apt &> /dev/null; then
        if command -v nala &> /dev/null; then
            nala search "$package"
        else
            apt search "$package"
        fi
    elif command -v dnf &> /dev/null; then
        dnf search "$package"
    elif command -v pacman &> /dev/null; then
        pacman -Ss "$package"
    elif command -v rpm-ostree &> /dev/null; then
        rpm-ostree search "$package"
    elif command -v xbps-query &> /dev/null; then
        xbps-query -R "$package"
    elif command -v zypper &> /dev/null; then
        zypper se "$package"
    fi

    if command -v flatpak &> /dev/null; then
        flatpak search "$package"
    fi

    if command -v snap &> /dev/null; then
        snap find "$package"
    fi
}

update_grub() {
    if command -v update-grub &> /dev/null; then
        sudo update-grub
    elif command -v grub2-mkconfig &> /dev/null; then
        sudo grub2-mkconfig
    else
        echo "GRUB not detected"
    fi
}

upgrade() {
    if command -v apt &> /dev/null; then
        if command -v nala &> /dev/null; then
            sudo nala upgrade
        else
            sudo apt update && sudo apt upgrade
        fi
    elif command -v dnf &> /dev/null; then
        sudo dnf upgrade
    elif command -v pacman &> /dev/null; then
        sudo pacman -Syu
        if command -v paru &> /dev/null; then
            paru -Syu
        elif command -v yay &> /dev/null; then
            yay -Syu
        fi
    elif command -v rpm-ostree &> /dev/null; then
        sudo rpm-ostree cleanup
    elif command -v xbps-install &> /dev/null; then
        sudo xbps-install -Su xbps && sudo xbps-install -u
    elif command -v zypper &> /dev/null; then
        if [ "$os" = "opensuse-tumbleweed" ] || [ "$os" = "opensuse-slowroll" ]; then
            sudo zypper ref && sudo zypper dup
        elif [ "$os" = "opensuse-leap" ]; then
            sudo zypper ref && sudo zypper up
        fi
    fi
    
    if command -v flatpak &> /dev/null; then
        flatpak update
    fi

    if command -v snap &> /dev/null; then
        sudo snap refresh
    fi
}
