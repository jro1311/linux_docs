# Enable mouse support
set mouse

# Set tab size
set tabsize 4

# Use spaces instead of tabs
set tabstospaces

# Set automatic indentation
set autoindent

# Show line numbers
set linenumbers

# Spread overlong lines over multiple screen lines
set softwrap

# Allow the editing of multiple files within a single buffer
set multibuffer

# Enable syntax highlighting
include "/usr/share/nano/*.nanorc"
